server {
  server_name api.yas.local;
  access_log /var/log/nginx/access.log yas_xff_json;

  # Only the private BFF containers may supply the original client address.
  # Reload nginx after either BFF is recreated with a different Docker IP.
  set_real_ip_from storefront;
  set_real_ip_from backoffice;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Normalize to one verified address instead of forwarding a caller-supplied chain.
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Forwarded "";

  # Docker DNS
  resolver 127.0.0.11;

  location /media/ {
    proxy_pass http://media;
  }
  location /swagger-ui/ {
    proxy_pass http://swagger-ui:8080;
  }
  location /product/ {
    proxy_pass http://product;
  }
  location /customer/ {
    proxy_pass http://customer;
  }
  location /cart/ {
    proxy_pass http://cart;
  }
  location /rating/ {
    proxy_pass http://rating;
  }
  location /order/ {
    proxy_pass http://order;
  }
  location /location/ {
    proxy_pass http://location;
  }
  location /inventory/ {
    proxy_pass http://inventory;
  }
  location /tax/ {
    proxy_pass http://tax;
  }
  location /promotion/ {
    proxy_pass http://promotion;
  }
  location /payment/ {
    proxy_pass http://payment;
  }
  location /sampledata/ {
    proxy_pass http://sampledata;
  }
}

server {
  server_name backoffice;
  access_log /var/log/nginx/access.log yas_xff_json;
  location / {
    proxy_pass http://backoffice;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
  }
}

server {
  server_name storefront;
  access_log /var/log/nginx/access.log yas_xff_json;
  location / {
    proxy_pass http://storefront;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
  }
}

server {
  server_name identity;
  access_log /var/log/nginx/access.log yas_xff_json;
  large_client_header_buffers 8 32k;
  location / {
    proxy_pass http://identity;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";

    # Workaround to void CORS error from Reactjs
    if ($uri ~ "^(.*)/(protocol/openid-connect/auth|login/oauth2/code)(.*)") {
    	add_header Access-Control-Allow-Origin *;
    }
  }
}
